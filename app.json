{
  "expo": {
    "name": "SOFA",
    "slug": "fleamarket-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ICONV4.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06534B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hokanama.fleamarketapp"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.NFC"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/ADAPTIVEICONV3.png",
        "backgroundColor": "#06534B"
      },
      "package": "com.hokanama.fleamarketapp",
      "versionCode": 1
    },
    "plugins": [
      "react-native-nfc-manager",
      [
        "expo-image-picker",
        {
          "photosPermission": "フリマアプリが写真へのアクセスを求めています",
          "cameraPermission": "フリマアプリがカメラへのアクセスを求めています"
        }
      ],
      "react-native-nfc-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "963c15f8-e6e7-4074-ac68-eb4e0e2d09aa"
      }
    }
  }
}
