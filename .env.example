# このファイルを .env にコピーして値を書き換えてください（.env は Git に含めません）
# スマホから開発サーバーに接続するための、PC の LAN 内 IP アドレス
#   Windows: ipconfig の「IPv4 アドレス」 / macOS: ipconfig getifaddr en0
HOST_LAN_IP=192.168.0.10

# Docker で APK をビルドする場合のみ（docker compose run --rm apk）
# Android SDK のライセンス（https://developer.android.com/studio/terms）を読んで同意する場合は yes にする
ACCEPT_ANDROID_SDK_LICENSES=no
